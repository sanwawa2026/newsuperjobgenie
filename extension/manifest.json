{
  "manifest_version": 3,
  "name": "SuperJobGenie - Western Job Boards AI Career Assistant",
  "version": "2.9.3",
  "description": "Unabridged 3,000+ char deep JD extractor & instant AI skills match analyzer across Indeed, LinkedIn, Glassdoor & top ATS platforms.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.indeed.com/*",
    "https://*.indeed.co.uk/*",
    "https://*.indeed.ca/*",
    "https://*.indeed.de/*",
    "https://*.indeed.fr/*",
    "https://*.indeed.es/*",
    "https://*.indeed.it/*",
    "https://*.indeed.jp/*",
    "https://*.linkedin.com/*",
    "https://*.glassdoor.com/*",
    "https://*.glassdoor.co.uk/*",
    "https://*.ziprecruiter.com/*",
    "https://*.dice.com/*",
    "https://*.greenhouse.io/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.wellfound.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.indeed.com/*",
        "https://*.indeed.co.uk/*",
        "https://*.indeed.ca/*",
        "https://*.indeed.de/*",
        "https://*.indeed.fr/*",
        "https://*.indeed.es/*",
        "https://*.indeed.it/*",
        "https://*.indeed.jp/*",
        "https://*.linkedin.com/*",
        "https://*.glassdoor.com/*",
        "https://*.glassdoor.co.uk/*",
        "https://*.ziprecruiter.com/*",
        "https://*.dice.com/*",
        "https://*.greenhouse.io/*",
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.wellfound.com/*"
      ],
      "js": [
        "resume-parser.js",
        "content.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
