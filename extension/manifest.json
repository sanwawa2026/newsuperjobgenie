{
  "manifest_version": 3,
  "name": "SuperJobGenie: AI Resume Matcher & Cover Letter",
  "short_name": "SuperJobGenie",
  "version": "4.0.8",
  "description": "Stop pasting job posts into ChatGPT. One click gives you an ATS match score, skill gaps, and a tailored cover letter.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.indeed.com/*",
    "https://*.indeed.hk/*",
    "https://*.indeed.com.tw/*",
    "https://*.indeed.com.sg/*",
    "https://*.indeed.co.uk/*",
    "https://*.indeed.ca/*",
    "https://*.indeed.de/*",
    "https://*.indeed.fr/*",
    "https://*.indeed.es/*",
    "https://*.indeed.it/*",
    "https://*.indeed.jp/*",
    "https://*.104.com.tw/*",
    "https://*.1111.com.tw/*",
    "https://*.cakeresume.com/*",
    "https://*.jobstreet.com.sg/*",
    "https://*.jobstreet.com.my/*",
    "https://*.linkedin.com/*",
    "https://*.glassdoor.com/*",
    "https://*.glassdoor.co.uk/*",
    "https://*.glassdoor.com.hk/*",
    "https://*.glassdoor.ca/*",
    "https://*.glassdoor.com.au/*",
    "https://*.glassdoor.sg/*",
    "https://*.glassdoor.ie/*",
    "https://*.glassdoor.in/*",
    "https://*.glassdoor.de/*",
    "https://*.glassdoor.fr/*",
    "https://*.glassdoor.es/*",
    "https://*.glassdoor.it/*",
    "https://*.ziprecruiter.com/*",
    "https://*.ziprecruiter.co.uk/*",
    "https://*.ziprecruiter.ca/*",
    "https://*.ziprecruiter.de/*",
    "https://*.dice.com/*",
    "https://*.greenhouse.io/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://*.myworkdayjobs.com/*",
    "https://myworkdayjobs.com/*",
    "https://*.wellfound.com/*",
    "https://*.joinhandshake.com/*",
    "https://joinhandshake.com/*",
    "https://*.joinhandshake.co.uk/*",
    "https://*.handshake.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.indeed.com/*",
        "https://*.indeed.hk/*",
        "https://*.indeed.com.tw/*",
        "https://*.indeed.com.sg/*",
        "https://*.indeed.co.uk/*",
        "https://*.indeed.ca/*",
        "https://*.indeed.de/*",
        "https://*.indeed.fr/*",
        "https://*.indeed.es/*",
        "https://*.indeed.it/*",
        "https://*.indeed.jp/*",
        "https://*.104.com.tw/*",
        "https://*.1111.com.tw/*",
        "https://*.cakeresume.com/*",
        "https://*.jobstreet.com.sg/*",
        "https://*.jobstreet.com.my/*",
        "https://*.linkedin.com/*",
        "https://*.glassdoor.com/*",
        "https://*.glassdoor.co.uk/*",
        "https://*.glassdoor.com.hk/*",
        "https://*.glassdoor.ca/*",
        "https://*.glassdoor.com.au/*",
        "https://*.glassdoor.sg/*",
        "https://*.glassdoor.ie/*",
        "https://*.glassdoor.in/*",
        "https://*.glassdoor.de/*",
        "https://*.glassdoor.fr/*",
        "https://*.glassdoor.es/*",
        "https://*.glassdoor.it/*",
        "https://*.ziprecruiter.com/*",
        "https://*.ziprecruiter.co.uk/*",
        "https://*.ziprecruiter.ca/*",
        "https://*.ziprecruiter.de/*",
        "https://*.dice.com/*",
        "https://*.greenhouse.io/*",
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://myworkdayjobs.com/*",
        "https://*.wellfound.com/*",
        "https://*.joinhandshake.com/*",
        "https://joinhandshake.com/*",
        "https://*.joinhandshake.co.uk/*",
        "https://*.handshake.com/*"
      ],
      "js": [
        "resume-parser.js",
        "content.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
